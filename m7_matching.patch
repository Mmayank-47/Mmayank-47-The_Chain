+++ b/m7_matching/matcher.py
@@ -0,0 +1,43 @@
+"""Glue: M3/M4/M5/M6 outputs -> per-responder utilities for the auction, plus gate decisions."""
+from __future__ import annotations
+
+from typing import Callable, Dict, Iterable, Optional, Tuple
+
+from .opportunity_cost import opp_cost, prices
+from .utility import Claim, Responder, gate, pair_utility
+
+RouteFn = Callable[[Responder, Claim], Optional[Tuple[float, float]]]   # -> (length_m, p_safe) | None
+ReachFn = Callable[[Responder, float], float]                           # (responder, route_len) -> p_reach
+
+
+def build_utilities(claims: Iterable[Claim], responders: Iterable[Responder], route_fn: RouteFn,
+                    reach_fn: ReachFn, assigned: frozenset = frozenset(), extra_demand=None,
+                    **kw):
+    """-> (utilities {responder: {claim: U > 0}}, decisions {(responder, claim): gate result})."""
+    cs = [c for c in claims if c.id not in assigned]
+    rs = list(responders)
+    price = prices(rs, cs, assigned, extra_demand)
+    util: Dict[str, Dict[str, float]] = {r.id: {} for r in rs}
+    decisions: Dict[Tuple[str, str], str] = {}
+    for r in rs:
+        for c in cs:
+            if c.need and c.need not in r.skills:
+                continue
+            route = route_fn(r, c)
+            if route is None:
+                decisions[(r.id, c.id)] = "no_route"
+                continue
+            length, p_safe = route
+            p_reach = reach_fn(r, length)
+            d = decisions[(r.id, c.id)] = gate(c.p_valid, p_safe, c.trust, p_reach)
+            if d != "dispatch":
+                continue
+            u = pair_utility(c, r, length, p_safe, p_reach, opp_cost(r, c, price), **kw)
+            if u > 0:
+                util[r.id][c.id] = u
+    return util, decisions
+
+
+def ranking(utilities: Dict[str, Dict[str, float]], claim_id: str):
+    """Deterministic responder order for one claim (same on every phone given the same inputs)."""
+    return [r for _, r in sorted((-u[claim_id], r) for r, u in utilities.items() if claim_id in u)]
diff --git a/m7_matching/opportunity_cost.py b/m7_matching/opportunity_cost.py
new file mode 100644
index 0000000..bdd2543
--- /dev/null
+++ b/m7_matching/opportunity_cost.py
@@ -0,0 +1,36 @@
+"""Shadow price on scarce skills: a medic's time is worth more when critical cases are likely.
+
+price(skill) = value * min(1, expected_demand / idle_supply). Using a skill the claim actually
+needs is free; using it on a claim that does not need it costs the price. This is how "the only
+medic is not sent to a minor emergency" falls out of the maths instead of a hard rule.
+"""
+from __future__ import annotations
+
+from typing import Dict, Iterable, Mapping, Optional
+
+from .utility import Claim, Responder
+
+CRITICAL = 0.7
+
+
+def expected_demand(claims: Iterable[Claim], skill: str, assigned: frozenset = frozenset(),
+                    critical: float = CRITICAL) -> float:
+    """Unassigned, plausible, critical claims needing `skill`, weighted by p_valid."""
+    return sum(c.p_valid for c in claims
+               if c.need == skill and c.urgency >= critical and c.id not in assigned)
+
+
+def prices(responders: Iterable[Responder], claims: Iterable[Claim], assigned: frozenset = frozenset(),
+           extra_demand: Optional[Mapping[str, float]] = None, value: float = 0.6) -> Dict[str, float]:
+    """extra_demand: expected arrivals not yet seen (unverified reports, base rate)."""
+    claims, rs = list(claims), list(responders)
+    out = {}
+    for s in {s for r in rs for s in r.skills}:
+        supply = sum(1 for r in rs if s in r.skills)
+        d = expected_demand(claims, s, assigned) + (extra_demand or {}).get(s, 0.0)
+        out[s] = value * min(1.0, d / supply)
+    return out
+
+
+def opp_cost(r: Responder, c: Claim, price: Mapping[str, float]) -> float:
+    return sum(price.get(s, 0.0) for s in r.skills if s != c.need)
