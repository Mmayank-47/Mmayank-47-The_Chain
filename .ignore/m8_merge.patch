@@ -0,0 +1,23 @@
+"""Glue: M8 events ride M0 as Messages (epidemic flood, so partitions heal when carried across)."""
+from __future__ import annotations
+
+from core.types import Message, Priority
+from .event_log import Event
+from .replica import Replica
+
+KIND = "m8.event"
+
+
+def to_message(ev: Event, now: float) -> Message:
+    prio = Priority.DISTRESS if ev.kind == "claim" else Priority.DISPATCH
+    return Message(KIND, prio, ev.node, ev.to_json(), ev.hlc, created=now)
+
+
+def attach(replica: Replica, node) -> None:
+    """node: m0_transport.node.MeshNode"""
+    replica.on_emit.append(lambda ev: node.originate(to_message(ev, replica.now_ms() / 1000), replica.now_ms() / 1000))
+
+    def deliver(msg: Message):
+        if msg.kind == KIND:
+            replica.ingest([Event.from_json(msg.payload)])
+    node.engine.on_deliver = deliver
diff --git a/m8_merge/conflict_rules.py b/m8_merge/conflict_rules.py
new file mode 100644
index 0000000..03bcbe4
--- /dev/null
+++ b/m8_merge/conflict_rules.py
@@ -0,0 +1,90 @@
+"""Dispatch book (a CRDT built from events) + the conflict rule + lease expiry.
+
+Every field merges with max or min, so replaying the same events in any order gives the same book.
+Rule: for one victim the furthest-along responder keeps it; losers short of ARRIVED are
+redirected, nobody at the door is cancelled. Lease expired + not RESOLVED = orphan; a claim with
+no live dispatch re-opens.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional
+
+from core.crdt import LWWMap
+from core.types import HLC, DispatchState
+from .event_log import Event
+
+_INF = HLC(2 ** 62, 0, "")
+
+
+def make_did(claim: str, responder: str) -> str:
+    return f"{claim}|{responder}"
+
+
+def split_did(did: str):
+    claim, responder = did.rsplit("|", 1)
+    return claim, responder
+
+
+@dataclass
+class Rec:
+    did: str
+    claim: str
+    responder: str
+    state: DispatchState = DispatchState.PROPOSED
+    created: Optional[HLC] = None
+    beat_ms: int = 0
+
+    def alive_ms(self) -> int:
+        return max(self.created.wall if self.created else 0, self.beat_ms)
+
+
+@dataclass
+class Plan:
+    winners: Dict[str, str] = field(default_factory=dict)   # claim -> did that keeps it
+    redirect: List[str] = field(default_factory=list)       # dids that should stand down
+    reopen: List[str] = field(default_factory=list)         # claims with no live dispatch
+
+
+class DispatchBook:
+    def __init__(self, lease_ms: int = 60_000):
+        self.lease_ms = lease_ms
+        self.claims = LWWMap()
+        self.recs: Dict[str, Rec] = {}
+
+    def apply(self, ev: Event):
+        d, k = ev.data, ev.kind
+        if k == "claim":
+            self.claims.set(d["claim"], {"cell": d.get("cell"), "urgency": d.get("urgency")}, ev.hlc)
+        elif k in ("dispatch", "state", "beat"):
+            claim, resp = split_did(d["did"])
+            if k != "dispatch" and ev.node != resp:
+                return                                # only the responder speaks for its progress
+            r = self.recs.setdefault(d["did"], Rec(d["did"], claim, resp))
+            if k == "dispatch":
+                r.created = ev.hlc if r.created is None else min(r.created, ev.hlc)
+            else:
+                r.beat_ms = max(r.beat_ms, ev.hlc.wall)
+                if k == "state":
+                    r.state = max(r.state, DispatchState(d["state"]))
+
+    def snapshot(self):
+        """Comparable view for convergence checks."""
+        return (sorted(self.claims.items(), key=lambda kv: kv[0]),
+                sorted((r.did, int(r.state), r.created, r.beat_ms) for r in self.recs.values()))
+
+    def plan(self, now_ms: int) -> Plan:
+        p, by_claim = Plan(), {}
+        for r in self.recs.values():
+            by_claim.setdefault(r.claim, []).append(r)
+        for claim, rs in by_claim.items():
+            if any(r.state == DispatchState.RESOLVED for r in rs):
+                continue
+            live = [r for r in rs if now_ms - r.alive_ms() <= self.lease_ms]
+            if not live:
+                p.reopen.append(claim)
+                continue
+            win = min(live, key=lambda r: (-int(r.state), r.created or _INF, r.responder))
+            p.winners[claim] = win.did
+            p.redirect += [r.did for r in live if r is not win and r.state < DispatchState.ARRIVED]
+        return p
diff --git a/m8_merge/event_log.py b/m8_merge/event_log.py
new file mode 100644
index 0000000..4d1ddfd
--- /dev/null
+++ b/m8_merge/event_log.py
@@ -0,0 +1,108 @@
+"""Signed, hash-chained per-node event logs + a store that accepts events from everyone.
+
+Events from one node must arrive in seq order; early ones are buffered until the gap fills
+(anti-entropy fills gaps). A node showing two different events for one seq is flagged as a fork.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+from dataclasses import dataclass
+from typing import Dict, List, Set
+
+from core.types import HLC, canonical, sha256_hex
+
+
+class DevSigner:
+    """STAND-IN for M1's hardware-bound keys. Insecure on purpose: key = hash(node id)."""
+
+    def _key(self, node: str) -> bytes:
+        return hashlib.sha256(b"dev-only:" + node.encode()).digest()
+
+    def sign(self, node: str, data: bytes) -> str:
+        return hmac.new(self._key(node), data, "sha256").hexdigest()
+
+    def verify(self, node: str, data: bytes, sig: str) -> bool:
+        return hmac.compare_digest(self.sign(node, data), sig)
+
+
+def _body(node, seq, prev, hlc, kind, data) -> dict:
+    return {"n": node, "s": seq, "p": prev, "h": hlc.to_json(), "k": kind, "d": data}
+
+
+@dataclass(frozen=True)
+class Event:
+    node: str
+    seq: int
+    prev: str          # hash of this node's previous event ("" for the first)
+    hlc: HLC
+    kind: str
+    data: dict
+    hash: str
+    sig: str
+
+    @staticmethod
+    def make(node, seq, prev, hlc, kind, data, signer) -> "Event":
+        h = sha256_hex(canonical(_body(node, seq, prev, hlc, kind, data)))
+        return Event(node, seq, prev, hlc, kind, data, h, signer.sign(node, h.encode()))
+
+    def to_json(self) -> dict:
+        return {**_body(self.node, self.seq, self.prev, self.hlc, self.kind, self.data),
+                "x": self.hash, "g": self.sig}
+
+    @staticmethod
+    def from_json(j: dict) -> "Event":
+        return Event(j["n"], int(j["s"]), j["p"], HLC.from_json(j["h"]), j["k"], j["d"], j["x"], j["g"])
+
+
+class EventStore:
+    def __init__(self, signer=None, max_pending: int = 256):
+        self.signer = signer or DevSigner()
+        self.max_pending = max_pending          # caps memory a hostile peer can make us buffer
+        self.logs: Dict[str, List[Event]] = {}
+        self.pending: Dict[str, Dict[int, Event]] = {}
+        self.forks: Set[str] = set()
+
+    def _valid(self, ev: Event) -> bool:
+        body = _body(ev.node, ev.seq, ev.prev, ev.hlc, ev.kind, ev.data)
+        return (bool(ev.node) and ev.seq >= 0 and sha256_hex(canonical(body)) == ev.hash
+                and self.signer.verify(ev.node, ev.hash.encode(), ev.sig))
+
+    def add(self, ev: Event) -> List[Event]:
+        """Returns events newly appended in order (the given one plus any it unblocked)."""
+        if not self._valid(ev):
+            return []
+        log = self.logs.setdefault(ev.node, [])
+        if ev.seq < len(log):
+            if log[ev.seq].hash != ev.hash:
+                self.forks.add(ev.node)
+            return []
+        if ev.seq > len(log):
+            p = self.pending.setdefault(ev.node, {})
+            if len(p) < self.max_pending:
+                p.setdefault(ev.seq, ev)
+            return []
+        out, cur = [], ev
+        while cur is not None:
+            if cur.prev != (log[-1].hash if log else ""):
+                self.forks.add(ev.node)
+                break
+            log.append(cur)
+            out.append(cur)
+            cur = self.pending.get(ev.node, {}).pop(len(log), None)
+        return out
+
+    def summary(self) -> Dict[str, list]:
+        """Version vector with head hashes: {node: [count, head_hash]}."""
+        return {n: [len(l), l[-1].hash] for n, l in self.logs.items() if l}
+
+    def missing(self, remote: Dict[str, list]) -> List[Event]:
+        """Events the remote summary lacks. Also spots forks (same count, different head)."""
+        out = []
+        for node, log in self.logs.items():
+            rc, rh = remote.get(node, [0, ""])
+            if rc > 0 and rc <= len(log) and log[rc - 1].hash != rh:
+                self.forks.add(node)
+            if rc < len(log):
+                out += log[rc:]
+        return out
diff --git a/m8_merge/replica.py b/m8_merge/replica.py
new file mode 100644
index 0000000..4145dcd
--- /dev/null
+++ b/m8_merge/replica.py
@@ -0,0 +1,72 @@
+"""Replica: one phone's M8 state. Local actions append signed events; ingest merges remote ones."""
+from __future__ import annotations
+
+import time
+from typing import Callable, Dict, List, Optional
+
+from core.types import DispatchState, HLClock
+from .conflict_rules import DispatchBook, Plan, make_did, split_did
+from .event_log import DevSigner, Event, EventStore
+
+
+class Replica:
+    def __init__(self, node_id: str, signer=None, now_ms: Optional[Callable[[], int]] = None,
+                 lease_ms: int = 60_000):
+        self.id = node_id
+        self.now_ms = now_ms or (lambda: int(time.time() * 1000))
+        self.clock = HLClock(node_id, self.now_ms)
+        self.signer = signer or DevSigner()
+        self.store = EventStore(self.signer)
+        self.book = DispatchBook(lease_ms)
+        self.on_emit: List[Callable[[Event], None]] = []   # M0 bridge hooks in here
+
+    # ---- local actions
+    def _emit(self, kind: str, data: dict) -> Event:
+        log = self.store.logs.get(self.id, [])
+        ev = Event.make(self.id, len(log), log[-1].hash if log else "", self.clock.now(),
+                        kind, data, self.signer)
+        for e in self.store.add(ev):
+            self.book.apply(e)
+        for cb in self.on_emit:
+            cb(ev)
+        return ev
+
+    def open_claim(self, claim: str, cell: str, urgency: float) -> Event:
+        return self._emit("claim", {"claim": claim, "cell": cell, "urgency": urgency})
+
+    def dispatch(self, claim: str, responder: str) -> str:
+        did = make_did(claim, responder)
+        self._emit("dispatch", {"did": did})
+        return did
+
+    def set_state(self, did: str, state: DispatchState) -> Event:
+        self._own(did)
+        return self._emit("state", {"did": did, "state": int(state)})
+
+    def heartbeat(self, did: str) -> Event:
+        self._own(did)
+        return self._emit("beat", {"did": did})
+
+    def _own(self, did: str):
+        if split_did(did)[1] != self.id:
+            raise ValueError("only the dispatched responder reports its own progress")
+
+    # ---- sync
+    def ingest(self, events: List[Event]) -> int:
+        n = 0
+        for ev in events:
+            for e in self.store.add(ev):
+                if e.node != self.id:
+                    self.clock.update(e.hlc)
+                self.book.apply(e)
+                n += 1
+        return n
+
+    def summary(self) -> Dict[str, list]:
+        return self.store.summary()
+
+    def events_for(self, remote_summary: Dict[str, list]) -> List[Event]:
+        return self.store.missing(remote_summary)
+
+    def plan(self, now_ms: Optional[int] = None) -> Plan:
+        return self.book.plan(self.now_ms() if now_ms is None else now_ms)
diff --git a/tests/test_m8.py b/tests/test_m8.py
new file mode 100644
index 0000000..0b29510
--- /dev/null
+++ b/tests/test_m8.py
@@ -0,0 +1,176 @@
+import dataclasses
+import random
+import unittest
+
+from core.crdt import LWWMap
+from core.types import HLC, DispatchState as S
+from m0_transport.node import build_sim_node
+from m0_transport.radio_adapter import SimMedium
+from m8_merge import bridge
+from m8_merge.event_log import Event, EventStore, DevSigner
+from m8_merge.replica import Replica
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1_000_000
+    def __call__(self):
+        return self.t
+
+
+def rep(name, clk, lease=60_000):
+    return Replica(name, now_ms=clk, lease_ms=lease)
+
+
+class TestCrdt(unittest.TestCase):
+    def test_lww_converges_either_order(self):
+        a, b = LWWMap(), LWWMap()
+        a.set("k", 1, HLC(1, 0, "x")); b.set("k", 2, HLC(2, 0, "y"))
+        a.merge(b); b.merge(a)
+        self.assertEqual((a.get("k"), b.get("k")), (2, 2))
+        a.delete("k", HLC(3, 0, "x")); b.merge(a)
+        self.assertIsNone(b.get("k"))
+
+
+class TestEventLog(unittest.TestCase):
+    def mk(self, n=3):
+        r = rep("a", Clock())
+        return r, [r.open_claim(f"c{i}", "X", 0.5) for i in range(n)]
+
+    def test_tamper_and_bad_signature_rejected(self):
+        _, evs = self.mk(1)
+        bad = dataclasses.replace(evs[0], data={"claim": "evil", "cell": "X", "urgency": 1})
+        self.assertEqual(EventStore().add(bad), [])
+        forged = dataclasses.replace(evs[0], node="b")
+        self.assertEqual(EventStore().add(forged), [])
+
+    def test_out_of_order_buffered_then_drained(self):
+        _, evs = self.mk(3)
+        s = EventStore()
+        self.assertEqual(s.add(evs[2]), [])
+        self.assertEqual(s.add(evs[1]), [])
+        self.assertEqual([e.seq for e in s.add(evs[0])], [0, 1, 2])
+
+    def test_fork_detected(self):
+        r1, r2 = rep("a", Clock()), rep("a", Clock())      # same identity, two histories
+        e1 = r1.open_claim("c1", "X", 0.1)
+        e2 = r2.open_claim("c2", "X", 0.9)
+        s = EventStore()
+        s.add(e1); s.add(e2)
+        self.assertIn("a", s.forks)
+
+
+class TestConflictAndLeases(unittest.TestCase):
+    def setUp(self):
+        self.clk = Clock()
+        self.a, self.b = rep("a", self.clk), rep("b", self.clk)
+
+    def sync(self):
+        self.a.ingest(self.b.events_for(self.a.summary()))
+        self.b.ingest(self.a.events_for(self.b.summary()))
+
+    def test_furthest_along_wins_and_door_not_cancelled(self):
+        self.a.open_claim("c1", "X", 0.9); self.sync()
+        self.clk.t += 1000
+        da = self.a.dispatch("c1", "a"); self.a.set_state(da, S.EN_ROUTE)
+        db = self.b.dispatch("c1", "b"); self.b.set_state(db, S.ARRIVED)
+        self.sync()
+        p = self.a.plan()
+        self.assertEqual(p.winners["c1"], db)
+        self.assertEqual(p.redirect, [da])
+        self.b.set_state(db, S.ARRIVED); self.a.set_state(da, S.ARRIVED); self.sync()
+        p = self.a.plan()
+        self.assertEqual(p.redirect, [])              # both at the door: nobody cancelled
+        self.assertEqual(p.winners["c1"], self.b.book.plan(self.clk.t).winners["c1"])
+
+    def test_tie_break_is_deterministic_on_both_replicas(self):
+        da, db = self.a.dispatch("c1", "a"), self.b.dispatch("c1", "b")
+        self.sync()
+        self.assertEqual(self.a.plan().winners, self.b.plan().winners)
+
+    def test_spoofed_progress_ignored(self):
+        da = self.a.dispatch("c1", "a")
+        with self.assertRaises(ValueError):
+            self.b.set_state(da, S.RESOLVED)           # local guard
+        evil = self.b._emit("state", {"did": da, "state": int(S.RESOLVED)})   # bypass guard
+        self.sync()
+        self.assertEqual(self.a.book.recs[da].state, S.PROPOSED)
+
+    def test_lease_orphan_reopens_and_heartbeat_keeps(self):
+        d = self.a.dispatch("c1", "a"); self.sync()
+        self.clk.t += 59_000
+        self.assertEqual(self.b.plan().reopen, [])
+        self.a.heartbeat(d); self.sync()
+        self.clk.t += 59_000
+        self.assertEqual(self.b.plan().reopen, [])     # heartbeat renewed the lease
+        self.clk.t += 5_000
+        self.assertEqual(self.b.plan().reopen, ["c1"])  # silent too long -> victim re-opens
+
+    def test_resolved_claim_not_reopened(self):
+        d = self.a.dispatch("c1", "a"); self.a.set_state(d, S.RESOLVED); self.sync()
+        self.clk.t += 10 ** 7
+        p = self.b.plan()
+        self.assertEqual((p.reopen, p.winners), ([], {}))
+
+    def test_state_never_moves_backward(self):
+        d = self.a.dispatch("c1", "a")
+        self.a.set_state(d, S.ARRIVED); self.a.set_state(d, S.ACCEPTED); self.sync()
+        self.assertEqual(self.b.book.recs[d].state, S.ARRIVED)
+
+
+class TestConvergence(unittest.TestCase):
+    def test_any_delivery_order_same_book(self):
+        clk = Clock()
+        rs = [rep(n, clk) for n in "abc"]
+        rs[0].open_claim("c1", "X", 0.9)
+        dids = [rs[i].dispatch("c1", "abc"[i]) for i in range(3)]
+        for i, d in enumerate(dids):
+            clk.t += 10
+            rs[i].set_state(d, S.EN_ROUTE if i else S.ARRIVED); rs[i].heartbeat(d)
+        every = [e for r in rs for l in r.store.logs.values() for e in l]
+        snaps = set()
+        for seed in range(25):
+            ev = every[:]; random.Random(seed).shuffle(ev)
+            fresh = rep("z", clk)
+            fresh.ingest(ev)                       # out-of-order buffering handles gaps
+            snaps.add(repr(fresh.book.snapshot()))
+        self.assertEqual(len(snaps), 1)
+
+
+class TestWithM0Partition(unittest.TestCase):
+    def test_islands_dispatch_independently_then_reconcile(self):
+        clk, m = Clock(), SimMedium(rng=random.Random(1))
+        names = ["a1", "a2", "b1", "b2"]
+        nodes = {n: build_sim_node(n, m) for n in names}
+        reps = {n: rep(n, clk, lease=120_000) for n in names}
+        for n in names:
+            bridge.attach(reps[n], nodes[n])
+        for x, y in [("a1", "a2"), ("a2", "b1"), ("b1", "b2")]:
+            m.link(x, y)
+
+        def run(secs):
+            for _ in range(secs):
+                clk.t += 1000
+                for n in nodes.values():
+                    n.tick(clk.t / 1000)
+
+        reps["a1"].open_claim("c1", "X", 0.9); run(10)
+        self.assertIsNotNone(reps["b2"].book.claims.get("c1"))   # claim reached both islands
+
+        m.unlink("a2", "b1")                                    # partition
+        da = reps["a1"].dispatch("c1", "a1"); reps["a1"].set_state(da, S.EN_ROUTE)
+        db = reps["b1"].dispatch("c1", "b2"); reps["b2"].set_state(db, S.ARRIVED)
+        run(20)
+        self.assertNotIn(db, reps["a1"].book.recs)             # islands really are blind
+        self.assertNotIn(da, reps["b2"].book.recs)
+
+        m.link("a2", "b1"); run(30)                             # heal
+        plans = [reps[n].plan() for n in names]
+        for p in plans:
+            self.assertEqual(p.winners["c1"], db)               # one responder keeps the victim
+            self.assertEqual(p.redirect, [da])                  # the other is redirected
+        self.assertEqual(len({repr(reps[n].book.snapshot()) for n in names}), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
