@@ -0,0 +1,33 @@
+"""Sim adapter: NaivePolicy plus an M3 gate. Claims wait in a pending pool and are released to
+dispatch only when p_valid clears `release`; corroboration arriving later can lift a held claim."""
+from __future__ import annotations
+
+from sim.baseline import NaivePolicy
+
+from .p_valid import Verifier
+
+
+class VerifiedPolicy(NaivePolicy):
+    def __init__(self, w, release: float = 0.6, ttl: float = 1800.0, verifier: Verifier = None):
+        super().__init__(w)
+        self.v = verifier or Verifier()
+        self.release, self.ttl = release, ttl
+        self.pending, self.scores = {}, {}
+
+    def p_valid(self, c):
+        return self.scores.get(c.id, 0.0)
+
+    def observe(self, c):
+        self.v.observe(c)
+        self.pending[c.id] = c
+
+    def tick(self, w):
+        for cid, c in list(self.pending.items()):
+            p = self.v.p_valid(c, w.t)
+            if p >= self.release:
+                del self.pending[cid]
+                self.scores[cid] = p
+                super().observe(c)
+            elif w.t - c.t > self.ttl:
+                del self.pending[cid]
+        return super().tick(w)
diff --git a/m3_verify/signals.py b/m3_verify/signals.py
new file mode 100644
index 0000000..ae970a6
--- /dev/null
+++ b/m3_verify/signals.py
@@ -0,0 +1,86 @@
+"""M3 signals. Each returns a log-likelihood ratio (LLR): >0 favours 'claim is real', <0 'fake'.
+
+Pure functions over a Ledger of claims seen so far. Only what a phone can observe is used
+(node, src, pos, t); never simulator ground truth. `node` = physical device (M1 binds it to a
+hardware key), `src` = identity the claim asserts.
+"""
+from __future__ import annotations
+
+import math
+from collections import defaultdict
+from typing import Callable, Dict, List, Optional
+
+SAME_PLACE_M = 100.0     # > GPS noise: two claims this close describe one place
+SAME_SPOT_M = 1.0        # copy-pasted coordinates
+CORROB_M = 150.0
+CORROB_WINDOW_S = 600.0
+FANOUT_WINDOW_S = 600.0
+
+
+class Ledger:
+    """Every claim this phone has seen, indexed by physical device."""
+
+    def __init__(self):
+        self.by_id: Dict[int, object] = {}
+        self.by_node: Dict[int, List[object]] = defaultdict(list)
+        self.latest = 0.0
+
+    def add(self, c) -> bool:
+        if c.id in self.by_id:
+            return False
+        self.by_id[c.id] = c
+        self.by_node[c.node].append(c)
+        self.latest = max(self.latest, c.t)
+        return True
+
+
+def _key(c):
+    return (c.t, c.id)
+
+
+def identity_binding(c) -> float:
+    """The device that sent the claim must be the identity it speaks for (spoof / sybil ids)."""
+    return 0.5 if c.src == c.node else -4.0
+
+
+def node_spread(L: Ledger, c) -> float:
+    """One phone cannot be in many places: penalise earlier claims from this device elsewhere."""
+    k = sum(1 for o in L.by_node[c.node]
+            if o.id != c.id and _key(o) < _key(c) and math.dist(o.pos, c.pos) > SAME_PLACE_M)
+    return -1.5 * min(k, 3)
+
+
+def identity_fanout(L: Ledger, c) -> float:
+    """One device speaking as many identities at about the same time."""
+    srcs = {o.src for o in L.by_node[c.node]
+            if o.id != c.id and abs(o.t - c.t) <= FANOUT_WINDOW_S} - {c.src}
+    return -0.5 * min(len(srcs), 6)
+
+
+def duplicate_spot(L: Ledger, c) -> float:
+    """Identical coordinates asserted by different identities (copy-paste crowd)."""
+    srcs = {o.src for o in L.by_id.values()
+            if o.id != c.id and o.src != c.src and math.dist(o.pos, c.pos) <= SAME_SPOT_M}
+    return -1.0 * min(len(srcs), 3)
+
+
+def corroboration(L: Ledger, c) -> float:
+    """Independent devices (other nodes, speaking for themselves) reporting the same place/time.
+    Same-device repeats never count. Real independence needs M1 co-presence proofs (M5 for collusion)."""
+    nodes = {o.node for o in L.by_id.values()
+             if o.node != c.node and o.src == o.node
+             and abs(o.t - c.t) <= CORROB_WINDOW_S and math.dist(o.pos, c.pos) <= CORROB_M}
+    return 1.5 * min(len(nodes), 3)
+
+
+def staleness(c, now: float, tau: float = 1800.0) -> float:
+    """Unrefreshed claims lose credibility, capped so old real victims are not written off."""
+    return -min(max(0.0, now - c.t) / tau, 1.0)
+
+
+def credential(c, check: Optional[Callable[[object], Optional[bool]]]) -> float:
+    """M1 hook: True = valid signed credential matches the need, False = forged/revoked, None = none."""
+    if check is None:
+        return 0.0
+    r = check(c)
+    return 0.0 if r is None else (3.0 if r else -4.0)
diff --git a/tests/test_m3.py b/tests/test_m3.py
new file mode 100644
index 0000000..a739dcd
--- /dev/null
+++ b/tests/test_m3.py
@@ -0,0 +1,128 @@
+import unittest
+from dataclasses import dataclass
+
+from m3_verify import challenge as ch
+from m3_verify.p_valid import Verifier
+
+_ids = iter(range(10 ** 6))
+
+
+@dataclass
+class C:
+    node: int
+    src: int
+    pos: tuple
+    t: float
+    id: int = 0
+    urgency: float = 0.5
+    need: str = None
+    battery: float = 0.5
+
+    def __post_init__(self):
+        self.id = next(_ids)
+
+
+def honest(node, pos=(500.0, 500.0), t=0.0):
+    return C(node, node, pos, t)
+
+
+class TestSignals(unittest.TestCase):
+    def test_lone_honest_claim_clears_release(self):
+        v = Verifier()
+        self.assertGreaterEqual(v.p_valid(honest(1)), 0.6)
+
+    def test_spoofed_identity_rejected(self):
+        v = Verifier()
+        self.assertLess(v.p_valid(C(node=9, src=1, pos=(0.0, 0.0), t=0.0)), 0.1)
+
+    def test_sybil_ids_from_one_device_rejected_and_cannot_corroborate(self):
+        v = Verifier()
+        cs = [C(7, 10_000 + j, (800.0, 800.0), 5.0) for j in range(10)]
+        for c in cs:
+            v.observe(c)
+        self.assertTrue(all(v.p_valid(c) < 0.1 for c in cs))
+        self.assertEqual(v.score(cs[0]).parts["corroboration"], 0.0)
+
+    def test_one_device_many_places_penalised_after_first(self):
+        v = Verifier()
+        cs = [C(5, 5, (300.0 * i + 300, 400.0), 10.0 * i) for i in range(4)]
+        for c in cs:
+            v.observe(c)
+        ps = [v.p_valid(c) for c in cs]
+        self.assertGreaterEqual(ps[0], 0.6)           # first claim indistinguishable from honest
+        self.assertTrue(all(p < ps[0] for p in ps[1:]))
+        self.assertLess(ps[-1], 0.2)
+
+    def test_independent_corroboration_raises_score(self):
+        v = Verifier()
+        a = honest(1, (500.0, 500.0), 0.0)
+        base = v.p_valid(a)
+        v.observe(honest(2, (540.0, 520.0), 30.0))
+        v.observe(honest(3, (480.0, 470.0), 60.0))
+        self.assertGreater(v.p_valid(a), base)
+
+    def test_staleness_lowers_but_is_capped(self):
+        v = Verifier()
+        c = honest(1)
+        fresh, old, ancient = v.p_valid(c, 0.0), v.p_valid(c, 1800.0), v.p_valid(c, 10 ** 6)
+        self.assertGreater(fresh, old)
+        self.assertEqual(old, ancient)
+
+    def test_credential_hook(self):
+        good = Verifier(credential=lambda c: True).p_valid(honest(1))
+        bad = Verifier(credential=lambda c: False).p_valid(honest(1))
+        self.assertGreater(good, 0.9)
+        self.assertLess(bad, 0.2)
+
+    def test_explanation_lists_biggest_reason(self):
+        v = Verifier()
+        d = v.score(C(9, 1, (0.0, 0.0), 0.0))
+        self.assertEqual(d.top_reasons(1)[0][0], "identity")
+
+    def test_order_independent(self):
+        a, b = honest(1, (500.0, 500.0), 0.0), honest(2, (520.0, 500.0), 20.0)
+        v1, v2 = Verifier(), Verifier()
+        v1.observe(a); v1.observe(b); v2.observe(b); v2.observe(a)
+        self.assertAlmostEqual(v1.p_valid(a, 100.0), v2.p_valid(a, 100.0))
+
+
+class TestChallenge(unittest.TestCase):
+    def setUp(self):
+        self.c = ch.make_challenge(claim_id=1, claimant=4, now=0.0, nonce="n1")
+        self.known = {5, 6, 7}
+
+    def resp(self, **kw):
+        d = dict(cid=self.c.cid, claimant=4, baro_hpa=1004.0, neighbors=frozenset({5, 6}), sent=30.0)
+        d.update(kw)
+        return ch.Response(**d)
+
+    def test_pass(self):
+        self.assertEqual(ch.check_response(self.c, self.resp(), 40.0, 1005.0, self.known), ch.PASS)
+
+    def test_wrong_pressure_or_invented_neighbours_fail(self):
+        self.assertEqual(ch.check_response(self.c, self.resp(baro_hpa=990.0), 40.0, 1005.0, self.known), ch.FAIL)
+        self.assertEqual(ch.check_response(self.c, self.resp(neighbors=frozenset({91, 92})), 40.0, 1005.0, self.known), ch.FAIL)
+        self.assertEqual(ch.check_response(self.c, self.resp(neighbors=frozenset()), 40.0, 1005.0, self.known), ch.FAIL)
+
+    def test_replay_or_relay_rejected(self):
+        other = ch.make_challenge(1, 4, 0.0, "n2")
+        self.assertEqual(ch.check_response(other, self.resp(), 40.0, 1005.0, self.known), ch.MISMATCH)
+        self.assertEqual(ch.check_response(self.c, self.resp(claimant=8), 40.0, 1005.0, self.known), ch.MISMATCH)
+
+    def test_silence_pending_then_weak_negative(self):
+        self.assertEqual(ch.check_response(self.c, None, 60.0, 1005.0, self.known), 0.0)
+        self.assertEqual(ch.check_response(self.c, None, 500.0, 1005.0, self.known), ch.LATE)
+        self.assertGreater(ch.LATE, ch.FAIL)
+
+    def test_challenge_result_moves_score(self):
+        v = Verifier()
+        c = honest(4)
+        base = v.p_valid(c)
+        v.record_challenge(c.id, ch.PASS)
+        self.assertGreater(v.p_valid(c), base)
+        v.record_challenge(c.id, ch.FAIL)
+        self.assertLess(v.p_valid(c), base)
+
+
+if __name__ == "__main__":
+    unittest.main()
