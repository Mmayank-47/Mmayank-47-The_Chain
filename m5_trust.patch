+++ b/m5_trust/beta_rep.py
@@ -0,0 +1,57 @@
+"""Beta reputation per node. Each phone keeps its own instance: trust is subjective, no global truth.
+
+Evidence is pseudo-counts on top of a cold-start prior. Evidence decays toward the prior with a
+half-life, so old behaviour matters less. Failures weigh more than successes (asymmetric), so
+reputation is slow to build and fast to lose.
+"""
+from __future__ import annotations
+
+import math
+from typing import Dict, Tuple
+
+# event -> (alpha weight, beta weight)
+EVENTS: Dict[str, Tuple[float, float]] = {
+    "verified_arrival":   (1.0, 0.0),
+    "confirmed_hazard":   (0.5, 0.0),
+    "corroborated_claim": (0.5, 0.0),
+    "failed_claim":       (0.0, 3.0),   # decoy / unverifiable emergency
+    "failed_challenge":   (0.0, 3.0),
+    "false_hazard":       (0.0, 2.0),
+}
+
+
+class BetaRep:
+    def __init__(self, prior_a: float = 1.0, prior_b: float = 1.0, half_life_s: float = 6 * 3600.0,
+                 max_event_weight: float = 3.0):
+        if prior_a <= 0 or prior_b <= 0 or half_life_s <= 0:
+            raise ValueError("prior and half-life must be positive")
+        self.pa, self.pb, self.half_life = prior_a, prior_b, half_life_s
+        self.cap = max_event_weight
+        self._ev: Dict[str, Tuple[float, float, float]] = {}   # node -> (extra_a, extra_b, t_last)
+
+    def _decayed(self, node: str, now: float) -> Tuple[float, float]:
+        a, b, t = self._ev.get(node, (0.0, 0.0, now))
+        f = 0.5 ** (max(0.0, now - t) / self.half_life)
+        return a * f, b * f
+
+    def record(self, node: str, event: str, now: float, weight: float = 1.0):
+        if event not in EVENTS:
+            raise KeyError(f"unknown event {event!r}")
+        w = max(0.0, min(weight, self.cap))
+        da, db = EVENTS[event]
+        a, b = self._decayed(node, now)
+        self._ev[node] = (a + da * w, b + db * w, now)
+
+    def evidence(self, node: str, now: float) -> float:
+        """How much (decayed) evidence backs the score: 0 for a stranger."""
+        a, b = self._decayed(node, now)
+        return a + b
+
+    def mean(self, node: str, now: float) -> float:
+        a, b = self._decayed(node, now)
+        return (self.pa + a) / (self.pa + a + self.pb + b)
+
+    def std(self, node: str, now: float) -> float:
+        a, b = self._decayed(node, now)
+        A, B = self.pa + a, self.pb + b
+        return math.sqrt(A * B / ((A + B) ** 2 * (A + B + 1)))
diff --git a/m5_trust/collusion.py b/m5_trust/collusion.py
new file mode 100644
index 0000000..6597c55
--- /dev/null
+++ b/m5_trust/collusion.py
@@ -0,0 +1,78 @@
+"""Collusion detection: tight clusters that only vouch for each other get discounted.
+
+A cluster is a strongly connected group of >= min_size nodes with no credentialed root inside and
+almost no vouches coming in from outside. Discounted, not banned: a genuine friend group nobody
+else has vouched for looks the same, and behaviour (BetaRep) can still earn it trust.
+"""
+from __future__ import annotations
+
+from typing import Dict, List, Set
+
+from .vouch_graph import VouchGraph
+
+
+def _sccs(nodes: List[str], out: Dict[str, Dict[str, float]]) -> List[Set[str]]:
+    """Kosaraju, iterative, deterministic order."""
+    seen, order = set(), []
+    for s in nodes:
+        if s in seen:
+            continue
+        seen.add(s)
+        stack = [(s, iter(sorted(out.get(s, {}))))]
+        while stack:
+            n, it = stack[-1]
+            for m in it:
+                if m not in seen:
+                    seen.add(m)
+                    stack.append((m, iter(sorted(out.get(m, {})))))
+                    break
+            else:
+                order.append(n)
+                stack.pop()
+    rev: Dict[str, List[str]] = {n: [] for n in nodes}
+    for u, vs in out.items():
+        for v in vs:
+            rev[v].append(u)
+    comps, done = [], set()
+    for s in reversed(order):
+        if s in done:
+            continue
+        comp, stack = set(), [s]
+        done.add(s)
+        while stack:
+            n = stack.pop()
+            comp.add(n)
+            for m in rev[n]:
+                if m not in done:
+                    done.add(m)
+                    stack.append(m)
+        comps.append(comp)
+    return comps
+
+
+def find_clusters(g: VouchGraph, min_size: int = 3, max_external_in: float = 0.2) -> List[Set[str]]:
+    nodes = sorted(g.nodes())
+    flagged = []
+    for comp in _sccs(nodes, g.out):
+        if len(comp) < min_size or comp & g.seeds:
+            continue
+        inside = outside = 0
+        for u, vs in g.out.items():
+            for v in vs:
+                if v in comp:
+                    if u in comp:
+                        inside += 1
+                    else:
+                        outside += 1
+        if inside and outside / (inside + outside) <= max_external_in:
+            flagged.append(comp)
+    return flagged
+
+
+def discounts(g: VouchGraph, factor: float = 0.2, **kw) -> Dict[str, float]:
+    """node -> multiplier (1.0 = no discount)."""
+    d: Dict[str, float] = {}
+    for comp in find_clusters(g, **kw):
+        for n in comp:
+            d[n] = factor
+    return d
