index 0000000..411cd3b
--- /dev/null
+++ b/m5_trust/trust.py
@@ -0,0 +1,42 @@
+"""trust(node): the M5 output that feeds the dispatch gate.
+
+Blend of graph trust and behavioural reputation. Strangers lean on the graph; as evidence builds
+the blend moves to observed behaviour. Collusion discount multiplies the result. `llr()` gives the
+same number as a log-likelihood ratio so M3 can add it as a signal.
+"""
+from __future__ import annotations
+
+import math
+from typing import Dict
+
+from .beta_rep import BetaRep
+from .collusion import discounts
+from .vouch_graph import VouchGraph
+
+
+class TrustEngine:
+    def __init__(self, graph: VouchGraph = None, rep: BetaRep = None,
+                 evidence_k: float = 4.0, cluster_factor: float = 0.2):
+        self.graph = graph or VouchGraph()
+        self.rep = rep or BetaRep()
+        self.k, self.cluster_factor = evidence_k, cluster_factor
+        self._disc = None
+        self._disc_edges = -1
+
+    def _discounts(self) -> Dict[str, float]:
+        n_edges = sum(len(v) for v in self.graph.out.values()) + len(self.graph.seeds)
+        if self._disc is None or n_edges != self._disc_edges:
+            self._disc = discounts(self.graph, self.cluster_factor)
+            self._disc_edges = n_edges
+        return self._disc
+
+    def trust(self, node: str, now: float) -> float:
+        g = self.graph.score(node)
+        n = self.rep.evidence(node, now)
+        w = n / (n + self.k)
+        t = (1 - w) * g + w * self.rep.mean(node, now)
+        return max(0.0, min(1.0, t * self._discounts().get(node, 1.0)))
+
+    def llr(self, node: str, now: float, limit: float = 3.0) -> float:
+        t = min(max(self.trust(node, now), 1e-6), 1 - 1e-6)
+        return max(-limit, min(limit, math.log(t / (1 - t))))
diff --git a/m5_trust/vouch_graph.py b/m5_trust/vouch_graph.py
new file mode 100644
index 0000000..f66aa70
--- /dev/null
+++ b/m5_trust/vouch_graph.py
@@ -0,0 +1,68 @@
+"""Vouch graph trust: personalised PageRank seeded from credentialed roots (EigenTrust / SybilRank style).
+
+Each voucher splits one unit of trust over everyone they vouch for, so vouching for many dilutes it.
+Trust leaks back to the seeds every step, so a ring of fake identities only holds what flows in
+through its few 'attack edges' and shares it across the whole ring.
+"""
+from __future__ import annotations
+
+from collections import defaultdict
+from typing import Dict, Iterable, Set
+
+
+class VouchGraph:
+    def __init__(self, seeds: Iterable[str] = (), alpha: float = 0.15, iters: int = 50):
+        self.seeds: Set[str] = set(seeds)
+        self.alpha, self.iters = alpha, iters
+        self.out: Dict[str, Dict[str, float]] = defaultdict(dict)
+        self._cache = None
+
+    def add_seed(self, node: str):
+        self.seeds.add(node)
+        self._cache = None
+
+    def vouch(self, u: str, v: str, w: float = 1.0):
+        if u == v or w <= 0:
+            return                                   # no self-vouching
+        self.out[u][v] = w                           # re-vouching replaces, never stacks
+        self._cache = None
+
+    def nodes(self) -> Set[str]:
+        n = set(self.seeds) | set(self.out)
+        for vs in self.out.values():
+            n |= set(vs)
+        return n
+
+    def rank(self) -> Dict[str, float]:
+        """Stationary trust mass; sums to 1 (all zeros without seeds)."""
+        nodes = self.nodes()
+        if not self.seeds:
+            return {n: 0.0 for n in nodes}
+        tele = {s: 1.0 / len(self.seeds) for s in self.seeds}
+        pr = {n: tele.get(n, 0.0) for n in nodes}
+        for _ in range(self.iters):
+            nxt = {n: self.alpha * tele.get(n, 0.0) for n in nodes}
+            for u in sorted(nodes):
+                mass = pr[u] * (1 - self.alpha)
+                outs = self.out.get(u)
+                if outs:
+                    tot = sum(outs.values())
+                    for v, w in outs.items():
+                        nxt[v] += mass * w / tot
+                else:                                # dangling: mass returns to the roots
+                    for s in tele:
+                        nxt[s] += mass * tele[s]
+            pr = nxt
+        return pr
+
+    def scores(self) -> Dict[str, float]:
+        """0..1. Roots are 1.0; others are measured against the root teleport floor."""
+        if self._cache is None:
+            pr = self.rank()
+            ref = (self.alpha / len(self.seeds)) if self.seeds else 1.0
+            self._cache = {n: min(1.0, p / ref) for n, p in pr.items()}
+        return self._cache
+
+    def score(self, node: str, default: float = 0.5) -> float:
+        """Strangers (not in the graph) get `default`."""
+        return self.scores().get(node, default)
diff --git a/tests/test_m5.py b/tests/test_m5.py
new file mode 100644
index 0000000..55a9d8b
--- /dev/null
+++ b/tests/test_m5.py
@@ -0,0 +1,163 @@
+import unittest
+
+from m5_trust.beta_rep import BetaRep
+from m5_trust.collusion import discounts, find_clusters
+from m5_trust.trust import TrustEngine
+from m5_trust.vouch_graph import VouchGraph
+
+
+def community(g, names, root):
+    g.vouch(root, names[0])
+    for a, b in zip(names, names[1:]):
+        g.vouch(a, b)
+        g.vouch(b, a)
+
+
+def sybil_ring(g, k=10, attack_from="h1"):
+    ring = [f"s{i}" for i in range(k)]
+    for a in ring:
+        for b in ring:
+            g.vouch(a, b)
+    g.vouch(attack_from, ring[0])              # one attack edge
+    return ring
+
+
+def world():
+    g = VouchGraph(seeds=["root", "root2"])
+    honest = [f"h{i}" for i in range(1, 6)]
+    community(g, honest, "root")
+    g.vouch("h1", "h3"); g.vouch("h2", "h5")
+    for r, n in [("root", "h3"), ("root", "h5"), ("root2", "h2"), ("root2", "h4")]:
+        g.vouch(r, n)                          # honest groups are vouched from several roots
+    return g, honest, sybil_ring(g)
+
+
+class TestBeta(unittest.TestCase):
+    def test_cold_start_and_updates(self):
+        r = BetaRep()
+        self.assertEqual(r.mean("x", 0), 0.5)
+        r.record("x", "verified_arrival", 0)
+        self.assertGreater(r.mean("x", 0), 0.5)
+
+    def test_failure_outweighs_success(self):
+        r = BetaRep()
+        r.record("x", "verified_arrival", 0)
+        r.record("x", "failed_claim", 0)
+        self.assertLess(r.mean("x", 0), 0.5)
+
+    def test_decay_returns_to_prior(self):
+        r = BetaRep(half_life_s=100)
+        for _ in range(5):
+            r.record("x", "verified_arrival", 0)
+        hi, later = r.mean("x", 0), r.mean("x", 10_000)
+        self.assertGreater(hi, later)
+        self.assertAlmostEqual(later, 0.5, places=3)
+        self.assertLess(r.evidence("x", 10_000), 0.01)
+
+    def test_weight_capped_and_unknown_event(self):
+        r = BetaRep()
+        r.record("x", "verified_arrival", 0, weight=10 ** 9)
+        self.assertLessEqual(r.evidence("x", 0), 3.0)
+        with self.assertRaises(KeyError):
+            r.record("x", "made_up", 0)
+
+    def test_uncertainty_shrinks_with_evidence(self):
+        r = BetaRep()
+        s0 = r.std("x", 0)
+        for _ in range(10):
+            r.record("x", "verified_arrival", 0)
+        self.assertLess(r.std("x", 0), s0)
+
+
+class TestVouch(unittest.TestCase):
+    def test_rank_sums_to_one_and_deterministic(self):
+        g, _, _ = world()
+        self.assertAlmostEqual(sum(g.rank().values()), 1.0, places=9)
+        self.assertEqual(g.rank(), world()[0].rank())
+
+    def test_roots_full_and_sybil_ring_far_below_honest(self):
+        g, honest, ring = world()
+        sc = g.scores()
+        self.assertEqual(sc["root"], 1.0)
+        h = sum(sc[n] for n in honest) / len(honest)
+        s = sum(sc[n] for n in ring) / len(ring)
+        self.assertGreater(h, 0.5)
+        self.assertLess(s, h / 3)
+
+    def test_ring_with_no_attack_edge_gets_nothing(self):
+        g = VouchGraph(seeds=["root"])
+        g.vouch("root", "a")
+        for x in "pqr":
+            for y in "pqr":
+                g.vouch(x, y)
+        self.assertEqual(g.score("p"), 0.0)
+
+    def test_vouching_for_many_dilutes(self):
+        a, b = VouchGraph(seeds=["r"]), VouchGraph(seeds=["r"])
+        a.vouch("r", "x")
+        b.vouch("r", "x")
+        for i in range(5):
+            b.vouch("r", f"y{i}")
+        self.assertLess(b.score("x"), a.score("x"))
+
+    def test_self_vouch_ignored_and_stranger_default(self):
+        g = VouchGraph(seeds=["r"])
+        g.vouch("z", "z")
+        self.assertEqual(g.score("z"), 0.5)
+
+    def test_no_seeds_no_trust(self):
+        g = VouchGraph()
+        g.vouch("a", "b")
+        self.assertEqual(g.score("b"), 0.0)
+
+
+class TestCollusion(unittest.TestCase):
+    def test_ring_flagged_honest_not(self):
+        g, honest, ring = world()
+        flagged = find_clusters(g)
+        self.assertEqual(flagged, [set(ring)])
+        d = discounts(g)
+        self.assertTrue(all(n in d for n in ring))
+        self.assertFalse(any(n in d for n in honest + ["root"]))
+
+    def test_seed_inside_cluster_protects_it(self):
+        g = VouchGraph(seeds=["a"])
+        for x in "abc":
+            for y in "abc":
+                g.vouch(x, y)
+        self.assertEqual(find_clusters(g), [])
+
+
+class TestEngine(unittest.TestCase):
+    def test_sybil_below_stranger_below_honest(self):
+        g, honest, ring = world()
+        e = TrustEngine(g)
+        self.assertLess(e.trust("s3", 0), 0.1)
+        self.assertEqual(e.trust("nobody", 0), 0.5)
+        self.assertGreater(e.trust("h2", 0), 0.5)
+
+    def test_bad_behaviour_drops_trusted_node(self):
+        g, _, _ = world()
+        e = TrustEngine(g)
+        before = e.trust("h2", 0)
+        for _ in range(3):
+            e.rep.record("h2", "failed_claim", 0)
+        self.assertLess(e.trust("h2", 0), before / 2)
+
+    def test_good_behaviour_lifts_stranger(self):
+        e = TrustEngine(VouchGraph(seeds=["r"]))
+        for _ in range(6):
+            e.rep.record("new", "verified_arrival", 0)
+        self.assertGreater(e.trust("new", 0), 0.7)
+
+    def test_llr_sign_and_bounds(self):
+        g, _, _ = world()
+        e = TrustEngine(g)
+        self.assertGreater(e.llr("h2", 0), 0)
+        self.assertLess(e.llr("s3", 0), 0)
+        self.assertAlmostEqual(e.llr("nobody", 0), 0.0)
+        self.assertLessEqual(abs(e.llr("root", 0)), 3.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
