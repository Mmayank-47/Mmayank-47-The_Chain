    <!-- OEM / battery kill protection -->
    <string name="oem_protect_heading">Keep ResQMesh running</string>
    <string name="oem_battery_rationale">The mesh needs a foreground service after reboot and in airplane mode. Allow unrestricted battery so the system does not kill the radio between Help and Respond.</string>
    <string name="oem_detected">Detected manufacturer: %1$s (brand %2$s)</string>
    <string name="oem_battery_request">Allow unrestricted battery</string>
    <string name="oem_battery_granted">Battery unrestricted — good.</string>
    <string name="oem_battery_deny_note">If you deny, the mesh may stop when the screen is off. You can change this later under Me.</string>
    <string name="oem_continue_ok">Continue to app</string>
    <string name="oem_continue_denied">Continue without unrestricted battery</string>
    <string name="oem_open_from_me">Autostart &amp; battery steps</string>

    <string name="oem_title_xiaomi">Xiaomi / Redmi / POCO — Autostart &amp; battery</string>
    <string name="oem_step_xiaomi_1">Settings → Apps → Manage apps → ResQMesh → Autostart → On</string>
    <string name="oem_step_xiaomi_2">Battery saver → No restrictions (or Unrestricted)</string>
    <string name="oem_step_xiaomi_3">Other permissions → Display pop-up windows while running in background → Allow</string>
    <string name="oem_step_xiaomi_4">Lock ResQMesh in Recents (pull down on the card → Lock)</string>

    <string name="oem_title_oppo">Oppo / Realme — Autostart &amp; battery</string>
    <string name="oem_step_oppo_1">Settings → App management → ResQMesh → Allow auto-launch → On</string>
    <string name="oem_step_oppo_2">Battery → App power management → ResQMesh → Allow background activity</string>
    <string name="oem_step_oppo_3">Lock ResQMesh in Recent apps</string>

    <string name="oem_title_vivo">Vivo / iQOO — Autostart &amp; battery</string>
    <string name="oem_step_vivo_1">Settings → Apps → ResQMesh → Autostart → Allow</string>
    <string name="oem_step_vivo_2">Battery → Background power consumption → ResQMesh → High background power</string>
    <string name="oem_step_vivo_3">iManager → App manager → Autostart manager → ResQMesh → On</string>

    <string name="oem_title_oneplus">OnePlus — Autostart &amp; battery</string>
    <string name="oem_step_oneplus_1">Settings → Apps → ResQMesh → Battery → Unrestricted</string>
    <string name="oem_step_oneplus_2">Battery → Battery optimization → ResQMesh → Don\'t optimize</string>
    <string name="oem_step_oneplus_3">Lock ResQMesh in Recents</string>

    <string name="oem_title_huawei">Huawei / Honor — Autostart &amp; battery</string>
    <string name="oem_step_huawei_1">Settings → Apps → ResQMesh → Battery → Unrestricted / Manual manage</string>
    <string name="oem_step_huawei_2">App launch → Manage manually → Auto-launch, secondary launch, run in background → On</string>
    <string name="oem_step_huawei_3">Lock ResQMesh in Recents</string>

    <string name="oem_title_samsung">Samsung — Sleeping apps</string>
    <string name="oem_step_samsung_1">Settings → Battery → Background usage limits → Never sleeping apps → Add ResQMesh</string>
    <string name="oem_step_samsung_2">Apps → ResQMesh → Battery → Unrestricted</string>
    <string name="oem_step_samsung_3">Turn off Adaptive battery for ResQMesh if it keeps stopping</string>

    <string name="oem_title_generic">Battery &amp; background</string>
    <string name="oem_step_generic_1">Settings → Apps → ResQMesh → Battery → Unrestricted</string>
    <string name="oem_step_generic_2">Allow notifications so the mesh foreground service stays visible</string>
    <string name="oem_step_generic_3">After reboot, open ResQMesh once if the radio does not restart on its own</string>

