@@ -0,0 +1,42 @@
+"""Low battery as an urgency feature, power modes, and the one-shot last-gasp packet."""
+from __future__ import annotations
+
+import math
+from enum import IntEnum
+
+
+class Mode(IntEnum):
+    NORMAL = 0
+    SAVER = 1
+    BEACON = 2      # duty-cycled beacon only, no relaying
+
+
+DUTY = {Mode.NORMAL: 1.0, Mode.SAVER: 0.5, Mode.BEACON: 0.1}
+SAVER_AT, BEACON_AT, LAST_GASP_AT = 0.30, 0.15, 0.05
+
+
+def mode(level: float) -> Mode:
+    return Mode.NORMAL if level > SAVER_AT else Mode.SAVER if level > BEACON_AT else Mode.BEACON
+
+
+def urgency(tts_s: float, tau: float = 3600.0) -> float:
+    """0..1; 1 = about to go silent. A victim at 12 % who will be silent soon outranks one at 80 %."""
+    return math.exp(-max(0.0, tts_s) / tau)
+
+
+def send_location_now(level: float, tts_s: float, window_s: float = 3600.0) -> bool:
+    """Push the exact (M9-protected) location out early while the phone can still transmit."""
+    return tts_s <= window_s or level <= BEACON_AT
+
+
+class LastGasp:
+    """Fires exactly once, the first time the level falls to LAST_GASP_AT or below."""
+
+    def __init__(self):
+        self.sent = False
+
+    def should_send(self, level: float) -> bool:
+        if not self.sent and level <= LAST_GASP_AT:
+            self.sent = True
+            return True
+        return False
diff --git a/tests/test_m4.py b/tests/test_m4.py
new file mode 100644
index 0000000..3fcbe3e
--- /dev/null
+++ b/tests/test_m4.py
@@ -0,0 +1,171 @@
+import math
+import random
+import unittest
+
+from m4_hazard.flood_model import FloodModel
+from m4_hazard.hazard_grid import HazardGrid
+from m4_hazard.location_filter import ParticleFilter
+from m4_hazard.router import RoadGraph, find_route
+
+
+def square_graph():
+    g = RoadGraph()
+    for n, p in {"A": (0, 0), "B": (200, 0), "C": (0, 200), "D": (200, 200)}.items():
+        g.add_node(n, p)
+    for a, b in [("A", "B"), ("A", "C"), ("C", "D"), ("D", "B")]:
+        g.add_edge(a, b)
+    return g
+
+
+class TestLocation(unittest.TestCase):
+    def test_radius_grows_without_fixes_and_shrinks_with_ranging(self):
+        truth = (100.0, 100.0)
+        pf = ParticleFilter(truth, 30.0, rng=random.Random(1))
+        r0 = pf.estimate()[1]
+        for _ in range(20):
+            pf.predict(0.0, 0.0, 4.0)
+        r1 = pf.estimate()[1]
+        self.assertGreater(r1, r0)                       # dead-reckoning drift widens the cloud
+        rng = random.Random(2)
+        for anchor in [(160.0, 100.0), (100.0, 170.0), (30.0, 90.0), (150.0, 30.0)]:
+            pf.update_range(anchor, math.dist(truth, anchor) + rng.gauss(0, 2), 5.0)
+        mean, r2 = pf.estimate()
+        self.assertLess(r2, r1 / 2)
+        self.assertLess(math.dist(mean, truth), 25.0)
+
+    def test_gps_fix_tightens(self):
+        pf = ParticleFilter((0.0, 0.0), 50.0, rng=random.Random(3))
+        r0 = pf.estimate()[1]
+        pf.update_gps((5.0, -3.0), 10.0)
+        self.assertLess(pf.estimate()[1], r0)
+
+    def test_altitude_against_dem_breaks_ambiguity(self):
+        dem = lambda p: p[0] * 0.1                      # slope in x
+        pf = ParticleFilter((100.0, 0.0), 40.0, rng=random.Random(4))
+        r0 = pf.estimate()[1]
+        pf.update_altitude(dem, 10.0, 0.5)              # x ~ 100
+        self.assertLess(pf.estimate()[1], r0)
+
+    def test_deterministic_given_seed(self):
+        a = ParticleFilter((0.0, 0.0), 10.0, rng=random.Random(9))
+        b = ParticleFilter((0.0, 0.0), 10.0, rng=random.Random(9))
+        for f in (a, b):
+            f.predict(1.0, 0.0, 1.0)
+            f.update_gps((1.0, 0.0), 5.0)
+        self.assertEqual(a.estimate(), b.estimate())
