+
+    def test_p_reach_falls_with_distance_and_low_charge(self):
+        self.assertGreater(p_reach(0.9, 500), 0.99)
+        self.assertLess(p_reach(0.9, 8000), 0.1)
+        self.assertLess(p_reach(0.2, 500), p_reach(0.9, 500))
